{
  "name": "dsh-daily-report",
  "version": "0.3.0",
  "description": "DSH 每日简报：会话摘要、工具统计、三层 HTML 日报、dsh 启停心跳、天气、7 日对比、成本建议、键鼠空闲健康提醒、周报/月报；欢迎页 logo 上方弹出早晨卡片。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node client/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.15",
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "daily-report",
    "digest",
    "weather",
    "health"
  ],
  "author": "Yutai233",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yutai233/dsh-daily-report.git"
  },
  "bugs": {
    "url": "https://github.com/Yutai233/dsh-daily-report/issues"
  },
  "homepage": "https://github.com/Yutai233/dsh-daily-report#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
